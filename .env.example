# Le Concierge Environment Variables
# 
# Copy this file to .env and fill in the values
# Never commit .env to git

# ============================================================================
# Mistral AI Configuration
# ============================================================================
# Required for all AI model calls (Vision, Voxtral, Le Chonk)
# Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# The door's Voice Agent voice; keep it equal to the worker's SPEECH_VOICE_ID.
VOICE_ID=gb_jane_neutral

# ============================================================================
# Server Configuration
# ============================================================================
# Port for the backend server
PORT=3000

# Node.js environment
NODE_ENV=development

# ============================================================================
# Replay Mode Configuration
# ============================================================================
# Set to "record" to record all external API calls
# Set to "replay" to use recorded responses instead of making real calls
# Leave unset or set to "off" to make real API calls
REPLAY_MODE=off

# ============================================================================
# Mistral Workflows (the API starts and signals executions)
# ============================================================================
# 1 keeps the API offline even with a key: visits are created locally
WORKFLOWS_REPLAY=0
# Which deployment runs visitor-arrival and parcel-arrival, when more than
# one deployment registers the same workflow name. Leave empty otherwise.
WORKFLOW_DEPLOYMENT_NAME=
# Largest face-api.js descriptor distance that counts as a match
FACE_MATCH_THRESHOLD=0.5

# ============================================================================
# Database Configuration
# ============================================================================
# Path to the SQLite database file
DATABASE_PATH=data/le-concierge.db

# ============================================================================
# WebSocket Configuration
# ============================================================================
# WebSocket URL for clients to connect to
WS_URL=ws://localhost:3000

# ============================================================================
# Intercom Configuration
# ============================================================================
# URL of the backend server for intercom devices
SERVER_URL=http://localhost:3000

# ============================================================================
# Application URLs
# ============================================================================
# URL of the backend API for web apps
API_URL=http://localhost:3000
