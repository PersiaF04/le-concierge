# Le Concierge Workflows worker environment
# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Required for real model calls and for the worker to connect to Mistral Studio.
MISTRAL_API_KEY=your_mistral_api_key_here

# Stable name for this deployment. The worker refuses to start without it.
DEPLOYMENT_NAME=le-concierge

# Base URL of the Le Concierge Node API that the activities call back into.
LE_CONCIERGE_API_URL=http://localhost:3000

# Set to 1 to run every activity from recorded fixtures instead of the network.
# Used by tests and by the offline demo.
WORKFLOWS_REPLAY=0

# Directory holding the recorded activity results (default: ./fixtures).
# WORKFLOWS_FIXTURES_DIR=fixtures

# Models. Override without touching code.
VISION_MODEL=pixtral-large-latest
TRANSCRIPTION_MODEL=voxtral-mini-latest
DECISION_MODEL=mistral-large-latest
SPEECH_MODEL=voxtral-mini-tts-latest
SPEECH_VOICE_ID=gb_jane_neutral

# How long visitor-arrival waits for the resident before declining.
VISITOR_DECISION_TIMEOUT_SECONDS=60
